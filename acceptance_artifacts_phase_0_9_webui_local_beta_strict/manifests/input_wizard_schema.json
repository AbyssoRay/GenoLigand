{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 0.9 Input Wizard",
  "type": "object",
  "required": [
    "project_basics",
    "molecule_type",
    "genome",
    "search_scope",
    "database_profile",
    "run_profile"
  ],
  "properties": {
    "project_basics": {
      "type": "object"
    },
    "molecule_type": {
      "enum": [
        "small_molecule",
        "peptide",
        "protein_ligand",
        "complex_structure"
      ]
    },
    "genome": {
      "type": "object"
    },
    "search_scope": {
      "type": "array"
    },
    "database_profile": {
      "type": "string"
    },
    "run_profile": {
      "type": "string"
    }
  }
}