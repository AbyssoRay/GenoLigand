{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genoligand.local/schemas/project.schema.json",
  "title": "GenoLigand Project",
  "type": "object",
  "required": ["project_id", "project_name", "project_status", "latest_run_id"],
  "additionalProperties": false,
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "project_name": { "type": "string", "minLength": 1 },
    "project_status": { "type": "string", "minLength": 1 },
    "latest_run_id": { "type": ["string", "null"] }
  }
}
