{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genoligand.local/schemas/patch_realization.schema.json",
  "title": "PatchRealizationResult",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "profile_id",
    "pass_l2",
    "matched_constraints",
    "rmsd",
    "score",
    "audit",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.6" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "pass_l2": { "type": "boolean" },
    "matched_constraints": { "type": "integer", "minimum": 0 },
    "rmsd": { "type": "number", "minimum": 0 },
    "score": { "type": "number", "minimum": 0 },
    "failure_reason": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
    "audit": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "version", "parameters_hash", "artifact_hash"],
      "properties": {
        "source": { "type": "string" },
        "version": { "type": "string" },
        "parameters_hash": { "type": "string" },
        "artifact_hash": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "pass_l2": { "const": true } } },
      "then": {
        "properties": {
          "failure_reason": { "type": "null" },
          "matched_constraints": { "minimum": 1 }
        }
      }
    }
  ],
  "additionalProperties": false
}
