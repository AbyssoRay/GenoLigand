      "minimum": "至少一个标准氨基酸序列或有效结构",
      "text": {
        "supported": true,
        "forms": ["amino_acid_sequence", "fasta"]
      },
      "file": {
        "supported": true,
        "extensions": ["fasta", "fa", "faa", "pdb", "cif", "mmcif", "ent"]
      },
      "constraints": {
        "minimum_records": 1,
        "all_records_must_convert": true
      }
    },
    {
      "kind": "complex",
      "field": "complex",
