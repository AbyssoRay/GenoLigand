      "text": {
        "supported": true,
        "forms": ["name", "cas", "smiles", "inchi"]
      },
      "file": {
        "supported": true,
        "extensions": ["sdf", "mol", "mol2"]
      },
      "constraints": {
        "minimum_records": 1,
        "all_records_must_convert": true
      }
    },
    {
