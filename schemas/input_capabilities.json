{
  "schema_version": "genoligand_input_capabilities_v1",
  "input_types": [
    {
      "kind": "small_molecule",
      "field": "small_molecule",
      "aliases": ["small-molecule", "molecule", "ligand", "smiles", "inchi", "cas"],
      "title": "小分子",
      "label": "名称、CAS、SMILES、InChI 或结构文件",
      "placeholder": "例如 CCO、InChI=1S/...、64-17-5，或 .sdf/.mol/.mol2 文件路径",
