{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genoligand.local/schemas/worker_result.schema.json",
  "title": "GenoLigand worker result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "worker",
    "status",
    "engine_version",
    "execution_status",
    "reason",
    "outcomes",
    "python_owns_final_score",
    "python_owns_report_semantics",
    "primitive_execution_only"
  ],
  "properties": {
    "schema_version": { "const": "genoligand_worker_current_v2" },
    "job_id": { "type": "string", "minLength": 1 },
    "worker": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PASS", "NOT_APPLICABLE", "NOT_READY", "FAIL"] },
    "engine_version": { "type": "string", "minLength": 1 },
    "execution_status": { "enum": ["completed", "not_applicable", "not_ready", "failed"] },
    "reason": { "type": "string", "minLength": 1 },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "reason", "required", "database_id", "row_count"],
        "properties": {
          "status": { "enum": ["completed", "not_applicable", "not_ready", "failed"] },
          "reason": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "database_id": { "type": "string", "minLength": 1 },
          "row_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "python_owns_final_score": { "const": false },
    "python_owns_report_semantics": { "const": false },
    "primitive_execution_only": { "const": true }
  }
}
