{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genoligand.local/schemas/tolerance_profile.schema.json",
  "title": "ToleranceProfile",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "dataset_id",
    "created_at",
    "interaction_kind",
    "ligand_class",
    "structure_confidence_bin",
    "radius_tolerance",
    "angle_tolerance_deg",
    "distance_bin_width",
    "vector_angle_bin_width",
    "max_bucket_occupancy",
    "max_seed_triplets",
    "max_memory_mb",
    "recall_at_profile",
    "hard_negative_rejection",
    "bucket_occupancy_p95",
    "peak_memory_mb",
    "runtime_ms_per_fixture",
    "generated_by_fixture_calibration",
    "profile_level"
  ],
  "properties": {
    "schema_version": { "const": "1.6" },
    "profile_id": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "interaction_kind": { "type": "string", "minLength": 1 },
    "ligand_class": { "type": "string", "minLength": 1 },
    "structure_confidence_bin": { "type": "string", "minLength": 1 },
    "radius_tolerance": { "type": "number", "exclusiveMinimum": 0 },
    "angle_tolerance_deg": { "type": "number", "exclusiveMinimum": 0 },
    "distance_bin_width": { "type": "number", "exclusiveMinimum": 0 },
    "vector_angle_bin_width": { "type": "number", "exclusiveMinimum": 0 },
    "max_bucket_occupancy": { "type": "integer", "minimum": 1 },
    "max_seed_triplets": { "type": "integer", "minimum": 1 },
    "max_memory_mb": { "type": "number", "exclusiveMinimum": 0 },
    "recall_at_profile": { "type": "number", "minimum": 0, "maximum": 1 },
    "hard_negative_rejection": { "type": "number", "minimum": 0, "maximum": 1 },
    "hard_negative_false_positive_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "bucket_occupancy_p95": { "type": "number", "minimum": 0 },
    "peak_memory_mb": { "type": "number", "minimum": 0 },
    "runtime_ms_per_fixture": { "type": "number", "minimum": 0 },
    "generated_by_fixture_calibration": { "const": true },
    "profile_level": { "enum": ["narrow", "standard", "relaxed"] }
  },
  "additionalProperties": false
}
