{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genoligand.local/schemas/artifact.schema.json",
  "title": "GenoLigand Artifact Summary",
  "type": "object",
  "required": ["id", "label", "exists"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "exists": { "type": "boolean" }
  }
}
