{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genoligand.local/schemas/geometry_budget_report.schema.json",
  "title": "GeometryBudgetReport",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "profile_id",
    "max_bucket_occupancy_observed",
    "seed_triplets_evaluated",
    "memory_estimate_mb",
    "runtime_ms",
    "relaxed_profiles_tried",
    "guard_triggered"
  ],
  "properties": {
    "schema_version": { "const": "1.6" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "max_bucket_occupancy_observed": { "type": "integer", "minimum": 0 },
    "seed_triplets_evaluated": { "type": "integer", "minimum": 0 },
    "memory_estimate_mb": { "type": "number", "minimum": 0 },
    "runtime_ms": { "type": "number", "minimum": 0 },
    "relaxed_profiles_tried": {
      "type": "array",
      "items": { "enum": ["narrow", "standard", "relaxed"] }
    },
    "guard_triggered": { "type": "boolean" },
    "failure_reason": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" }
  },
  "additionalProperties": false
}
