{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genoligand.local/schemas/install_status.schema.json",
  "title": "GenoLigand Install Status",
  "type": "object",
  "required": ["status", "progress_percent", "next_action"],
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string" },
    "progress_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "next_action": { "type": "string" },
    "science_store_path": { "type": ["string", "null"] },
    "tool_status": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "database_status": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  }
}
