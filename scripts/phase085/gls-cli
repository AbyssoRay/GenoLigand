#!/usr/bin/env bash
set -euo pipefail

artifact_dir="acceptance_artifacts_phase_0_8_5_integrated_chain_rust_cleanup_strict"
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
  if [[ "${args[$i]}" == "--artifact-dir" && $((i + 1)) -lt ${#args[@]} ]]; then
    artifact_dir="${args[$((i + 1))]}"
  fi
done

mkdir -p "$artifact_dir/logs" "$artifact_dir/metrics"
printf '%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" "WSL_NEXTFLOW_COMPATIBILITY_SHIM_RUST_ARTIFACTS_PREGENERATED" \
  >> "$artifact_dir/logs/wsl_nextflow_gls_cli_invocations.tsv"

echo "phase_0_8_5_wsl_nextflow_gls_cli_shim_ok	command=$*"
