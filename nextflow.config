profiles {
  dev_cpu_smoke {
    process.executor = 'local'
    process.cpus = 12
    process.memory = '32 GB'
    env.PATH = "/usr/local/bin:/usr/bin:/bin:${System.getenv('PATH') ?: ''}"
    workDir = "${System.getenv('HOME')}/.cache/genoligand-nextflow-work"
    params.outdir = 'results/dev_cpu_smoke'
  }
  mock {
    process.executor = 'local'
    process.cpus = 12
    process.memory = '32 GB'
    env.PATH = "/usr/local/bin:/usr/bin:/bin:${System.getenv('PATH') ?: ''}"
    params.outdir = 'results/phase_0_4_mock'
    params.plm_backend = 'fixture_mock'
    params.plm_device = 'cpu'
    params.model_id = 'fixture_mock_64'
    params.similarity_backend = 'fixture_mock'
  }
  cpu {
    process.executor = 'local'
    process.cpus = 12
    process.memory = '32 GB'
    env.PATH = "/usr/local/bin:/usr/bin:/bin:${System.getenv('PATH') ?: ''}"
    params.outdir = 'results/phase_0_4_cpu'
    params.plm_backend = 'esm2_fair'
    params.plm_device = 'cpu'
    params.model_id = 'esm2_t6_8M_UR50D'
  }
  cuda {
    process.executor = 'local'
    process.cpus = 12
    process.memory = '32 GB'
    env.PATH = "/usr/local/bin:/usr/bin:/bin:${System.getenv('PATH') ?: ''}"
    params.outdir = 'results/phase_0_4_cuda'
    params.plm_backend = 'esm2_fair'
    params.plm_device = 'cuda'
    params.model_id = 'esm2_t6_8M_UR50D'
    process {
      withName: PHASE_0_4_SEQUENCE_EVIDENCE {
        accelerator = 1
        containerOptions = '--gpus all'
      }
    }
  }
  gpu {
    process.executor = 'local'
    process.cpus = 12
    process.memory = '32 GB'
    env.CUDA_HOME = 'D:\\Program Files\\CUDA'
    env.PATH = "/usr/bin:/bin:/c/Windows/System32:/d/Program Files/CUDA/bin:/d/Program Files/CUDA/libnvvp:${System.getenv('PATH') ?: ''}"
    params.cuda_home = 'D:\\Program Files\\CUDA'
    params.nvcc = 'D:\\Program Files\\CUDA\\bin\\nvcc.exe'
    params.outdir = 'results/phase_0_5_gpu_strict'
    process {
      withLabel: gpu {
        accelerator = 1
        cpus = 12
        memory = '32 GB'
      }
    }
  }
  phase06_strict_local {
    process.executor = 'local'
    process.cpus = 12
    process.memory = '32 GB'
    env.PATH = "/d/Program Files/Git/usr/bin:/d/Program Files/Git/bin:/usr/bin:/bin:/c/Windows/System32:${System.getenv('PATH') ?: ''}"
    params.outdir = 'results/phase_0_6_structure_patch_strict'
    params.artifact_dir = 'acceptance_artifacts_phase_0_6_structure_patch_strict'
    params.phase05_dir = 'acceptance_artifacts_phase_0_5_gpu_strict'
    params.foldseek_wsl_distro = 'GenoLigandPhase06'
    params.foldseek_bin = '/opt/foldseek/foldseek/bin/foldseek'
    params.usalign_bin = '.phase_0_6_tools/USalign/USalign.exe'
  }
  strict_local {
    process.executor = 'local'
    process.cpus = 12
    process.memory = '32 GB'
    env.PATH = "/d/Program Files/Git/usr/bin:/d/Program Files/Git/bin:/usr/bin:/bin:/c/Windows/System32:${System.getenv('PATH') ?: ''}"
    params.outdir = 'results/phase_0_8_2_mapping_benchmark_storage_strict'
    params.artifact_dir = 'acceptance_artifacts_phase_0_8_2_mapping_benchmark_storage_strict'
    params.python = System.getenv('GENOLIGAND_PHASE082_PYTHON') ?: System.getenv('GENOLIGAND_PHASE081_PYTHON') ?: System.getenv('GENOLIGAND_PHASE08_PYTHON') ?: 'python'
  }
  local_strict {
    process.executor = 'local'
    process.cpus = 20
    process.memory = '32 GB'
    env.PATH = "/d/Program Files/Git/usr/bin:/d/Program Files/Git/bin:/usr/bin:/bin:/c/Windows/System32:${System.getenv('PATH') ?: ''}"
    params.outdir = 'results/phase_0_8_3_biolip2_resolver_patch_strict'
    params.artifact_dir = 'acceptance_artifacts_phase_0_8_3_biolip2_resolver_patch_strict'
    params.python = System.getenv('GENOLIGAND_PHASE083_PYTHON') ?: System.getenv('GENOLIGAND_PHASE082_PYTHON') ?: System.getenv('GENOLIGAND_PHASE081_PYTHON') ?: System.getenv('GENOLIGAND_PHASE08_PYTHON') ?: 'python'
  }
  wsl2_cuda {
    process.executor = 'local'
    process.cpus = 20
    process.memory = '24 GB'
    env.PATH = "/d/Program Files/Git/usr/bin:/d/Program Files/Git/bin:/usr/bin:/bin:/c/Windows/System32:${System.getenv('PATH') ?: ''}"
    params.acceptance_mode = 'phase_0_8_4_openmm_short_md_strict'
    params.openmm_platform = 'CUDA'
    params.outdir = 'results/phase_0_8_4_openmm_short_md_strict'
    params.artifact_dir = 'acceptance_artifacts_phase_0_8_4_openmm_short_md_strict'
    params.python = System.getenv('GENOLIGAND_PHASE084_PYTHON') ?: 'python'
  }
  linux_cuda {
    process.executor = 'local'
    process.cpus = 20
    process.memory = '24 GB'
    params.acceptance_mode = 'phase_0_8_4_openmm_short_md_strict'
    params.openmm_platform = 'CUDA'
    params.outdir = 'results/phase_0_8_4_openmm_short_md_strict'
    params.artifact_dir = 'acceptance_artifacts_phase_0_8_4_openmm_short_md_strict'
    params.python = System.getenv('GENOLIGAND_PHASE084_PYTHON') ?: 'python'
  }
  cpu_dev_smoke {
    process.executor = 'local'
    process.cpus = 12
    process.memory = '32 GB'
    params.acceptance_mode = 'cpu_dev_smoke_not_pass_eligible'
    params.openmm_platform = 'CPU'
    params.outdir = 'results/phase_0_8_4_cpu_dev_smoke'
    params.artifact_dir = 'acceptance_artifacts_phase_0_8_4_openmm_short_md_strict'
    params.python = System.getenv('GENOLIGAND_PHASE084_PYTHON') ?: 'python'
  }
  strict_offline_cached {
    process.executor = 'local'
    process.cpus = 12
    process.memory = '32 GB'
    env.PATH = "/d/Program Files/Git/usr/bin:/d/Program Files/Git/bin:/usr/bin:/bin:/c/Windows/System32:${System.getenv('PATH') ?: ''}"
    params.outdir = 'results/phase_0_6_structure_patch_strict_cached'
    params.artifact_dir = 'acceptance_artifacts_phase_0_6_structure_patch_strict'
    params.phase05_dir = 'acceptance_artifacts_phase_0_5_gpu_strict'
    params.foldseek_wsl_distro = 'GenoLigandPhase06'
    params.foldseek_bin = '/opt/foldseek/foldseek/bin/foldseek'
    params.usalign_bin = '.phase_0_6_tools/USalign/USalign.exe'
  }
  strict_gpu_optional {
    process.executor = 'local'
    process.cpus = 12
    process.memory = '32 GB'
    env.CUDA_HOME = 'D:\\Program Files\\CUDA'
    env.PATH = "/d/Program Files/Git/usr/bin:/d/Program Files/Git/bin:/usr/bin:/bin:/c/Windows/System32:/d/Program Files/CUDA/bin:/d/Program Files/CUDA/libnvvp:${System.getenv('PATH') ?: ''}"
    params.outdir = 'results/phase_0_6_structure_patch_strict_gpu_optional'
    params.artifact_dir = 'acceptance_artifacts_phase_0_6_structure_patch_strict'
    params.phase05_dir = 'acceptance_artifacts_phase_0_5_gpu_strict'
    params.foldseek_wsl_distro = 'GenoLigandPhase06'
    params.foldseek_bin = '/opt/foldseek/foldseek/bin/foldseek'
    params.usalign_bin = '.phase_0_6_tools/USalign/USalign.exe'
  }
  strict {
    process.executor = 'local'
    process.cpus = 12
    process.memory = '32 GB'
    env.PATH = "/d/Program Files/Git/usr/bin:/d/Program Files/Git/bin:/usr/bin:/bin:/c/Windows/System32:${System.getenv('PATH') ?: ''}"
    params.outdir = 'results/phase_0_7_anti_hallucination_strict'
    params.artifact_dir = 'acceptance_artifacts_phase_0_7_anti_hallucination_strict'
    params.phase06_dir = 'acceptance_artifacts_phase_0_6_structure_patch_strict'
    params.phase05_dir = 'acceptance_artifacts_phase_0_5_gpu_strict'
    params.vina_bin = System.getenv('GENOLIGAND_PHASE07_VINA') ?: 'vina'
    params.ligand_prep_command = System.getenv('GENOLIGAND_PHASE07_LIGAND_PREP') ?: 'mk_prepare_ligand.py'
    params.receptor_prep_command = System.getenv('GENOLIGAND_PHASE07_RECEPTOR_PREP') ?: 'mk_prepare_receptor.py'
    params.obabel_bin = System.getenv('GENOLIGAND_PHASE07_OBABEL') ?: 'obabel'
  }
  control_only {
    process.executor = 'local'
    process.cpus = 12
    process.memory = '32 GB'
    env.PATH = "/d/Program Files/Git/usr/bin:/d/Program Files/Git/bin:/usr/bin:/bin:/c/Windows/System32:${System.getenv('PATH') ?: ''}"
    params.outdir = 'results/phase_0_7_1_audit_fix_strict'
    params.artifact_dir = 'acceptance_artifacts_phase_0_7_1_audit_fix_strict'
    params.phase07_dir = 'acceptance_artifacts_phase_0_7_anti_hallucination_strict'
    params.python = System.getenv('GENOLIGAND_PHASE07_PYTHON') ?: 'python'
  }
  local_full_db {
    process.executor = 'local'
    process.cpus = 12
    process.memory = '32 GB'
    env.PATH = "/d/Program Files/Git/usr/bin:/d/Program Files/Git/bin:/usr/bin:/bin:/c/Windows/System32:${System.getenv('PATH') ?: ''}"
    params.outdir = 'results/phase_0_8_full_database_strict'
    params.artifact_dir = 'acceptance_artifacts_phase_0_8_full_database_strict'
    params.python = System.getenv('GENOLIGAND_PHASE08_PYTHON') ?: 'python'
  }
  local_audit_fix {
    process.executor = 'local'
    process.cpus = 12
    process.memory = '32 GB'
    env.PATH = "/d/Program Files/Git/usr/bin:/d/Program Files/Git/bin:/usr/bin:/bin:/c/Windows/System32:${System.getenv('PATH') ?: ''}"
    params.outdir = 'results/phase_0_8_1_database_audit_fix_strict'
    params.artifact_dir = 'acceptance_artifacts_phase_0_8_1_database_audit_fix_strict'
    params.python = System.getenv('GENOLIGAND_PHASE081_PYTHON') ?: System.getenv('GENOLIGAND_PHASE08_PYTHON') ?: 'python'
  }
}

report {
  overwrite = true
}

timeline {
  overwrite = true
}

trace {
  overwrite = true
}
