profiles {
  local_production {
    process.executor = 'local'
    env.PATH = "/usr/local/bin:/usr/bin:/bin:${System.getenv('PATH') ?: ''}"
    params.pipeline_cpus = 20
    params.pipeline_memory = '32 GB'
    params.outdir = 'outputs/current_pipeline'
    params.science_store = System.getenv('GENOLIGAND_SCIENCE_STORE') ?: 'science_store'
    params.gls_cli = System.getenv('GENOLIGAND_GLS_CLI') ?: 'target/debug/gls-cli'
  }

  windows_local {
    process.executor = 'local'
    env.PATH = "/d/Program Files/Git/usr/bin:/d/Program Files/Git/bin:/usr/bin:/bin:/c/Windows/System32:${System.getenv('PATH') ?: ''}"
    params.pipeline_cpus = 20
    params.pipeline_memory = '32 GB'
    params.outdir = 'outputs/current_pipeline'
    params.science_store = System.getenv('GENOLIGAND_SCIENCE_STORE') ?: 'science_store'
    params.gls_cli = System.getenv('GENOLIGAND_GLS_CLI') ?: 'target/debug/gls-cli.exe'
  }

  local_acceptance {
    process.executor = 'local'
    env.PATH = "/usr/local/bin:/usr/bin:/bin:${System.getenv('PATH') ?: ''}"
    params.pipeline_cpus = 4
    params.pipeline_memory = '8 GB'
    params.outdir = 'outputs/nextflow-acceptance'
    params.science_store = 'science_store'
    params.gls_cli = 'target/debug/gls-cli'
  }
}

params.input_manifest = params.input_manifest ?: 'input_manifest.json'
params.pipeline_cpus = params.pipeline_cpus ?: 20
params.pipeline_memory = params.pipeline_memory ?: '32 GB'
params.outdir = params.outdir ?: 'outputs/current_pipeline'
params.science_store = params.science_store ?: (System.getenv('GENOLIGAND_SCIENCE_STORE') ?: 'science_store')
params.gls_cli = params.gls_cli ?: (System.getenv('GENOLIGAND_GLS_CLI') ?: 'gls-cli')

trace {
  overwrite = true
}

report {
  overwrite = true
}

timeline {
  overwrite = true
}

